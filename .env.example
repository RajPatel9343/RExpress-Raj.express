# Database connection string
# For local zero-configuration SQLite:
DATABASE_URL="file:./dev.db"
# For production PostgreSQL:
# DATABASE_URL="postgresql://user:password@localhost:5432/ecommerce?schema=public"

# App URL & Authentication
NEXT_PUBLIC_APP_URL="http://localhost:3000"
JWT_SECRET="super-secret-production-grade-jwt-key-change-in-production-2026"
SESSION_COOKIE_NAME="ecommerce_session_token"

# Razorpay Payment Gateway (Indian payments)
RAZORPAY_KEY_ID="rzp_test_samplekey12345"
RAZORPAY_KEY_SECRET="rzp_test_samplesecret67890"
RAZORPAY_WEBHOOK_SECRET="rzp_test_webhooksecret"

# Cashfree Payment Gateway (Optional alternative)
CASHFREE_APP_ID=""
CASHFREE_SECRET_KEY=""
CASHFREE_ENV="TEST"

# Shipping & Logistics (Shiprocket / Delhivery)
SHIPROCKET_API_USER=""
SHIPROCKET_API_PASSWORD=""
DELHIVERY_API_TOKEN=""

# Cloudinary / S3 Image Storage
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Transactional Email (SMTP / Resend / SendGrid)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="notifications@example.com"
SMTP_PASS=""
SMTP_FROM="Modern Commerce <no-reply@example.com>"

# Store Information
NEXT_PUBLIC_STORE_NAME="NEXUS LUXE"
NEXT_PUBLIC_STORE_CURRENCY="INR"
NEXT_PUBLIC_STORE_CURRENCY_SYMBOL="₹"
